{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "deos-shared-test-proof",
  "main": "worker.ts",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-09-27",
  "account_id": "c68856288112af7698f5be52ea94b96e",
  "observability": {"enabled": true},
  "d1_databases": [{
    "binding": "DB",
    "database_name": "deos-sample-project",
    "database_id": "4e854f8a-018a-42c4-a325-c4b8805c06b2"
  }],
  "r2_buckets": [{
    "binding": "ARTIFACTS",
    "bucket_name": "deos-sample-project-artifacts"
  }]
}
