{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "deos-workflow-portal",
  "main": "src/worker.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "c68856288112af7698f5be52ea94b96e",
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true }
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "configured-by-deploy",
    "ACCESS_AUD": "configured-by-deploy",
    "ALLOWED_EMAIL": "sachinkundu@gmail.com"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "deos-sample-project",
    "database_id": "4e854f8a-018a-42c4-a325-c4b8805c06b2"
  }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "deos.voxdez.com", "custom_domain": true }]
}
