{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposalStatements"],
  "properties": {
    "proposalStatements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["proposalLine", "requirementLinkIds", "coverage", "rationale"],
        "properties": {
          "proposalLine": { "type": "integer", "minimum": 1 },
          "requirementLinkIds": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
          },
          "coverage": { "type": "string", "enum": ["sufficient", "partial", "missing"] },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
