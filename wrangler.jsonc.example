{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "deos-sample-project",
  "main": "src/entry.py",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["python_workers"],
  "account_id": "SET_CLOUDFLARE_ACCOUNT_ID",
  "vars": {
    "LINEAR_PROJECT_IDS": "99426d9b-cda7-4db4-9136-692a95a0b090",
    "LINEAR_START_TRANSITIONS": "In Progress,Started"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deos-sample-project",
      "database_id": "SET_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "QUEUE",
        "queue": "deos-sample-project-events"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "deos-sample-project-artifacts"
    }
  ]
}
