              }
            ]
          },
          {
            "id": "scenario-context-isolation-weakened",
            "severity": "low",
            "category": "operability",
            "message": "The runtime instructions require a fresh browser context and known data per demonstration scenario, while the migration plan requests fresh contexts only where considered required. The collection plan should preserve the per-scenario isolation requirement explicitly.",
