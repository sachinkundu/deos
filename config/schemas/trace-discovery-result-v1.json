{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deos.dev/schemas/trace-discovery-result-v1.json",
  "$defs": {
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "scope", "minimality", "rationale"],
      "properties": {
        "coverage": { "type": "string", "enum": ["sufficient", "partial", "missing"] },
        "scope": { "type": "string", "enum": ["in_scope", "mixed", "out_of_scope"] },
        "minimality": { "type": "string", "enum": ["minimal", "over_specified", "uncertain"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["change", "review", "passingJudgment", "proposalStatements", "capabilities", "findings", "directionalLinks"],
  "properties": {
    "change": { "type": "string", "minLength": 1 },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reviewer", "promptVersion", "reviewedAt", "overall", "passes"],
      "properties": {
        "kind": { "type": "string", "const": "semantic-spec-review" },
        "reviewer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name", "version"],
          "properties": {
            "type": { "type": "string", "const": "llm" },
            "name": { "type": "string", "const": "codex-cli" },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "promptVersion": { "type": "string", "const": "openspec-semantic-traceability-directional-v3" },
        "reviewedAt": { "type": "string", "minLength": 1 },
        "overall": { "type": "string", "enum": ["pass", "findings"] },
        "passes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["direction", "promptVersion"],
            "properties": {
              "direction": { "type": "string", "enum": ["proposal_to_spec", "spec_to_proposal"] },
              "promptVersion": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "passingJudgment": { "$ref": "#/$defs/judgment" },
    "proposalStatements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["proposalLine", "requirementLinkIds", "coverage", "rationale"],
        "properties": {
          "proposalLine": { "type": "integer", "minimum": 1 },
          "requirementLinkIds": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
          },
          "coverage": { "type": "string", "enum": ["sufficient", "partial", "missing"] },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "capabilityLine", "judgment", "links"],
        "properties": {
          "path": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$" },
          "capabilityLine": { "type": "integer", "minimum": 1 },
          "judgment": { "$ref": "#/$defs/judgment" },
          "links": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "proposalLines", "specStartLine", "judgment"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                "proposalLines": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "integer", "minimum": 1 }
                },
                "specStartLine": { "type": "integer", "minimum": 1 },
                "judgment": { "$ref": "#/$defs/judgment" }
              }
            }
          }
        }
      }
    },
    "directionalLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["proposalLine", "requirementLinkId", "status", "proposalFirst", "requirementFirst"],
        "properties": {
          "proposalLine": { "type": "integer", "minimum": 1 },
          "requirementLinkId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "status": { "type": "string", "enum": ["confirmed", "proposal_only", "requirement_only"] },
          "proposalFirst": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claimed", "rationale"],
            "properties": {
              "claimed": { "type": "boolean" },
              "rationale": { "type": "string", "minLength": 1 }
            }
          },
          "requirementFirst": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claimed", "rationale"],
            "properties": {
              "claimed": { "type": "boolean" },
              "rationale": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "message", "capability", "proposalLines", "specStartLine"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "type": { "type": "string", "enum": ["missing_coverage", "unsupported_requirement", "over_specified", "ambiguous"] },
          "message": { "type": "string", "minLength": 1 },
          "capability": { "type": "string", "minLength": 1 },
          "proposalLines": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 1 }
          },
          "specStartLine": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
