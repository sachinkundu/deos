#!/bin/bash
set -euo pipefail
# Playwright owns the pipe and creates this fresh profile as root. Give only
# that directory to a separate browser account, then preserve the pipe FDs
# while dropping privileges. Never pass the supervisor's environment onward.
profile=''
for argument in "$@"; do
  case "$argument" in --user-data-dir=*) profile="${argument#--user-data-dir=}" ;; esac
done
case "$profile" in /tmp/playwright_chromiumdev_profile-*) ;; *) echo 'Unexpected Chromium profile path' >&2; exit 1 ;; esac
test -d "$profile" && test ! -L "$profile"
test "$(stat -c %u "$profile")" = 0
chown deos-browser:deos-browser "$profile"
chmod 700 "$profile"
exec setpriv --reuid=deos-browser --regid=deos-browser --init-groups \
  env -i HOME=/home/deos-browser PATH=/usr/local/bin:/usr/bin:/bin \
  /opt/deos-browser/chromium_headless_shell-1243/chrome-headless-shell-linux64/chrome-headless-shell "$@"
